# Server
PORT=8787
# Postgres connection string. Leave empty in development to use an embedded database in DATA_DIR.
DATABASE_URL=
DATA_DIR=./data
# Where the builder app is served (used in emailed links)
APP_URL=http://localhost:5173
# Public base URL of the API/server (used for form endpoints and site links)
PUBLIC_URL=http://localhost:8787
# Optional: serve sites at <slug>.example.com (needs wildcard DNS). Empty = /s/<slug>/ paths.
SITES_DOMAIN=
COOKIE_SECURE=false
TRUST_PROXY=false
# Require a verified email before publishing (default: true in production only)
REQUIRE_VERIFIED=
# Email: leave SMTP_URL empty to print emails to the console
SMTP_URL=
MAIL_FROM=Site Builder <no-reply@localhost>
